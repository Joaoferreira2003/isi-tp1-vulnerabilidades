    {
      "id": 5,
      "type": "barchart",
      "title": "Vulnerabilidades por imagem e prioridade",
      "description": "Prioridade não é severidade: uma CVE no KEV é sempre crítica, por mais baixo que seja o CVSS.",
      "datasource": {
        "type": "postgres",
        "uid": "isi-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "isi-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT imagem, COALESCE(SUM(n_vulnerabilidades) FILTER (WHERE prioridade = 'Crítica'), 0) AS \"Crítica\", COALESCE(SUM(n_vulnerabilidades) FILTER (WHERE prioridade = 'Alta'), 0) AS \"Alta\", COALESCE(SUM(n_vulnerabilidades) FILTER (WHERE prioridade = 'Média'), 0) AS \"Média\", COALESCE(SUM(n_vulnerabilidades) FILTER (WHERE prioridade = 'Baixa'), 0) AS \"Baixa\" FROM vw_vuln_por_imagem GROUP BY imagem ORDER BY imagem;"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
