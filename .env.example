# TP1 ISI — modelo de configuração. Copiar para .env e preencher.
# Este ficheiro (.env.example) VAI para o git; o .env NÃO vai.

# ---- A) PostgreSQL nativo (desenvolvimento: DBeaver + KNIME) ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=isi_tp1
PG_SCHEMA=public
PG_USER=postgres
PG_PASSWORD=

# ---- B) PostgreSQL em contentor (docker-compose.yml) ----
# Porta 5433 para coexistir com uma instalação nativa na 5432.
PGD_PORT=5433
PGD_DATABASE=isi_tp1
PGD_USER=isi
PGD_PASSWORD=

# ---- Caminhos das fontes (relativos à raiz do projeto) ----
DIR_TRIVY=dados/trivy
FILE_KEV_JSON=dados/kev/kev.json
FILE_KEV_CSV=dados/kev/kev.csv
FILE_EPSS=dados/epss/epss.csv
FILE_CWE=dados/cwe/cwec_v4.20.xml

# ---- Metadados de reprodutibilidade (ver docs/notas.md) ----
EPSS_SCORE_DATE=2026-10-08
KEV_CATALOG_VERSION=2026.10.08
CWE_VERSION=4.20
TRIVY_VERSION=0.75.0

# ---- Grafana (docker-compose.yml) ----
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=
